# ==========================================
# Slate Apparels - Firebase Auth Environment Keys
# ==========================================
# 1. Create a project at https://console.firebase.google.com/
# 2. Enable Authentication -> Sign-in method (Google, Phone, Email/Password)
# 3. Add Web App in Project Settings -> General -> Your apps
# 4. Copy the values below into .env.local in the "ecom" folder:

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
